{
  "expo": {
    "name": "MyRoots",
    "slug": "heritage",
    "scheme": "heritage",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.heritage.storybook",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MyRoots records family stories in your voice so they can be turned into text and kept safe."
      }
    },
    "android": {
      "package": "com.heritage.storybook",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "MyRoots records family stories in your voice so they can be turned into text and kept safe."
        }
      ],
      "expo-sharing"
    ]
  }
}
